+// imedical managed transport: upstream keeps its account-isolated jars and TLS policy.
+pub fn managed_enabled() -> bool {
+    std::env::var("IRIS_MANAGED_NO_RETRIES").as_deref() == Ok("1")
+}
+static MANAGED_GUARD: LazyLock<tokio::sync::Mutex<()>> = LazyLock::new(|| tokio::sync::Mutex::new(()));
+static MANAGED_UNCERTAIN: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+static MANAGED_BLOCKED: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+static MANAGED_HTTP_SENDS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+static MANAGED_AUTH: LazyLock<Mutex<std::collections::BTreeMap<String, HeaderValue>>> = LazyLock::new(Default::default);
+static MANAGED_STORES: LazyLock<Mutex<std::collections::BTreeMap<String, Arc<CspSessionStore>>>> = LazyLock::new(Default::default);
+static MANAGED_COOKIE_NAMES: LazyLock<Mutex<std::collections::BTreeMap<String, String>>> = LazyLock::new(Default::default);
+static MANAGED_SCOPES: LazyLock<Mutex<std::collections::BTreeMap<String, (String, String, bool)>>> = LazyLock::new(Default::default);
+static MANAGED_LOGOUT: LazyLock<Mutex<std::collections::BTreeMap<String, Vec<(String, HeaderValue)>>>> = LazyLock::new(Default::default);
+
+pub fn managed_blocked() -> bool { MANAGED_BLOCKED.load(std::sync::atomic::Ordering::SeqCst) }
+pub fn note_managed_dispatch() {
+    if managed_enabled() {
+        let sequence=MANAGED_HTTP_SENDS.fetch_add(1,std::sync::atomic::Ordering::SeqCst)+1;
+        eprintln!("IMEDICAL_HTTP_SEND={sequence}");
+    }
+}
+fn managed_error() -> reqwest::Error {
+    MANAGED_UNCERTAIN.store(true, std::sync::atomic::Ordering::SeqCst);
+    MANAGED_BLOCKED.store(true, std::sync::atomic::Ordering::SeqCst);
+    eprintln!("IMEDICAL_SESSION_STOP=identity-unverified");
+    reqwest::Client::new().get("http://[").build().unwrap_err()
+}
+fn cookie_names(store: &CspSessionStore, url: &Url) -> Option<String> {
+    let header=store.cookies(url)?;
+    let mut names: Vec<String> = header.to_str().ok()?.split(';').filter_map(|pair| {
+        let (name, value)=pair.trim().split_once('=')?;
+        (name.starts_with(SESSION_COOKIE_PREFIX) && !value.is_empty()).then(|| name.to_string())
+    }).collect();
+    names.sort();
+    (!names.is_empty()).then(|| names.join(";"))
+}
+fn remember_logout(key: &str, store: &CspSessionStore, url: &Url, replace: bool) {
+    let Some(cookie)=store.cookies(url) else { return; };
+    let origin=url.origin().ascii_serialization();
+    let target=store.logout_urls().into_iter().find(|u| {
+        u.starts_with(&origin) && url.as_str().starts_with(u.split('?').next().unwrap_or(""))
+    });
+    if let Some(target)=target {
+        let mut all=MANAGED_LOGOUT.lock().unwrap();
+        let items=all.entry(key.to_string()).or_default();
+        if replace { items.clear(); }
+        if items.len()<2 && !items.iter().any(|(u,c)|u==&target && c==&cookie) { items.push((target,cookie)); }
+    }
+}
+fn validate_scope(header: &HeaderValue, url: &Url) {
+    let Ok(text)=header.to_str() else { let _=managed_error(); return; };
+    let mut parts=text.split(';').map(str::trim);
+    let name=parts.next().unwrap_or("").split('=').next().unwrap_or("");
+    if !name.starts_with(SESSION_COOKIE_PREFIX) { return; }
+    let mut domain=url.host_str().unwrap_or("").to_ascii_lowercase();
+    let mut path=url.path()[..=url.path().rfind('/').unwrap_or(0)].to_string();
+    let mut secure=false;
+    for part in parts {
+        if part.eq_ignore_ascii_case("secure") { secure=true; }
+        if let Some((key,value))=part.split_once('=') {
+            if key.eq_ignore_ascii_case("domain") { domain=value.trim_start_matches('.').to_ascii_lowercase(); }
+            if key.eq_ignore_ascii_case("path") && value.starts_with('/') { path=value.to_string(); }
+        }
+    }
+    if path.is_empty() { path="/".into(); }
+    let prefix=if path.ends_with('/') { path.clone() } else { format!("{path}/") };
+    if domain!=url.host_str().unwrap_or("").to_ascii_lowercase() || secure && url.scheme()!="https" || !(url.path()==path || url.path().starts_with(&prefix)) { let _=managed_error(); return; }
+    let key=format!("{}|{}",url.origin().ascii_serialization(),name);
+    let scope=(domain,path,secure);
+    let mut known=MANAGED_SCOPES.lock().unwrap();
+    if known.get(&key).is_some_and(|old| old!=&scope) { let _=managed_error(); return; }
+    known.insert(key,scope);
+}
+fn managed_logout(timeout: Duration) {
+    let targets: Vec<(String,HeaderValue)>=MANAGED_LOGOUT.lock().unwrap().values().flatten().cloned().collect();
+    let attempted=targets.len();
+    if attempted==0 {
+        eprintln!("IMEDICAL_LOGOUT={{\"attempted\":0,\"acknowledged\":0,\"completed\":{}}}", !MANAGED_UNCERTAIN.load(std::sync::atomic::Ordering::SeqCst));
+        return;
+    }
+    let (done_tx,done_rx)=std::sync::mpsc::channel();
+    std::thread::spawn(move || {
+        let Ok(rt)=tokio::runtime::Builder::new_current_thread().enable_all().build() else { return; };
+        let acknowledged=rt.block_on(async {
+            let mut acknowledged=0;
+            for (url,cookie) in targets {
+                let Ok(client)=super::http::client_for(&setting_for(&url),super::http::ClientKind::Raw) else { continue; };
+                if let Ok(response)=client.get(url).header(reqwest::header::COOKIE,cookie).timeout(timeout).send().await {
+                    let renewed=response.headers().get_all(reqwest::header::SET_COOKIE).iter().any(|h|
+                        h.to_str().ok().and_then(|v|v.split(';').next()).and_then(|v|v.split_once('='))
+                            .is_some_and(|(n,v)|n.starts_with(SESSION_COOKIE_PREFIX) && !v.is_empty()));
+                    if response.status().is_success() || response.status().as_u16()==401 {
+                        if !renewed { acknowledged+=1; } else { let _=managed_error(); }
+                    }
+                }
+            }
+            acknowledged
+        });
+        let _=done_tx.send(acknowledged);
+    });
+    let result=done_rx.recv_timeout(timeout);
+    eprintln!("IMEDICAL_LOGOUT={{\"attempted\":{},\"acknowledged\":{},\"completed\":{}}}",attempted,result.as_ref().copied().unwrap_or(0),result.is_ok() && !MANAGED_UNCERTAIN.load(std::sync::atomic::Ordering::SeqCst));
+}
+
+pub trait ManagedSend {
+    fn send_managed(self) -> impl std::future::Future<Output=Result<reqwest::Response,reqwest::Error>> + Send;
+}
+impl ManagedSend for reqwest::RequestBuilder {
+    async fn send_managed(self) -> Result<reqwest::Response,reqwest::Error> {
+        if !managed_enabled() { return self.send().await; }
+        let (client,built)=self.build_split();
+        let mut request=built?;
+        let url=request.url().clone();
+        let Some((base,_))=url.as_str().split_once("/api/atelier") else { return client.execute(request).await; };
+        let key=base.to_ascii_lowercase();
+        let _guard=MANAGED_GUARD.lock().await;
+        if managed_blocked() { return Err(managed_error()); }
+        let auth=request.headers().get(reqwest::header::AUTHORIZATION).cloned();
+        let store=if let Some(auth)=auth {
+            {
+                let mut known=MANAGED_AUTH.lock().unwrap();
+                if known.get(&key).is_some_and(|old| old!=&auth) { return Err(managed_error()); }
+                known.entry(key.clone()).or_insert_with(||auth.clone());
+            }
+            use base64::Engine as _;
+            let encoded=auth.to_str().ok().and_then(|s|s.strip_prefix("Basic ")).ok_or_else(managed_error)?;
+            let decoded=base64::engine::general_purpose::STANDARD.decode(encoded).map_err(|_|managed_error())?;
+            let credentials=String::from_utf8(decoded).map_err(|_|managed_error())?;
+            let (username,_)=credentials.split_once(':').ok_or_else(managed_error)?;
+            let store=store_for_primary(base,username);
+            MANAGED_STORES.lock().unwrap().insert(key.clone(),store.clone());
+            store
+        } else {
+            MANAGED_STORES.lock().unwrap().get(&key).cloned().ok_or_else(managed_error)?
+        };
+        let previous=MANAGED_COOKIE_NAMES.lock().unwrap().get(&key).cloned();
+        let current=cookie_names(&store,&url);
+        if previous.is_some() && current!=previous { return Err(managed_error()); }
+        if current.is_some() {
+            remember_logout(&key,&store,&url,true);
+            request.headers_mut().remove(reqwest::header::AUTHORIZATION);
+            if let Some(cookie)=store.cookies(&url) { request.headers_mut().insert(reqwest::header::COOKIE,cookie); }
+        }
+        note_managed_dispatch();
+        let response=match client.execute(request).await { Ok(response)=>response,Err(error)=>{let _=managed_error();return Err(error);} };
+        // Raw clients expose headers; primary clients already recorded them. Both use this identity's jar.
+        store.set_cookies(&mut response.headers().get_all(reqwest::header::SET_COOKIE).iter(),&url);
+        if [401,403,503].contains(&response.status().as_u16()) {
+            MANAGED_BLOCKED.store(true,std::sync::atomic::Ordering::SeqCst);
+            eprintln!("IMEDICAL_HTTP_STOP={}",response.status().as_u16());
+        }
+        let after=cookie_names(&store,&url);
+        if MANAGED_UNCERTAIN.load(std::sync::atomic::Ordering::SeqCst) || after.is_none() || previous.is_some() && after!=previous {
+            remember_logout(&key,&store,&url,false);
+            return Err(managed_error());
+        }
+        remember_logout(&key,&store,&url,true);
+        MANAGED_COOKIE_NAMES.lock().unwrap().insert(key,after.unwrap());
+        Ok(response)
+    }
+}
