+fn validate_scope(header:&HeaderValue,url:&Url) {
+    let Ok(text)=header.to_str() else {let _=managed_error();return;};
+    let mut parts=text.split(';').map(str::trim);
+    let name=parts.next().unwrap_or("").split('=').next().unwrap_or("");
+    if !name.starts_with(SESSION_COOKIE_PREFIX) {return;}
