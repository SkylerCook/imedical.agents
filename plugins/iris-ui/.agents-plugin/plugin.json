{
  "name": "iris-ui",
  "version": "0.3.3",
  "displayName": "IRIS CSP＋HISUI 适配",
  "description": "将 imedical-ui 公司规范落实到 IRIS CSP＋HISUI，核对公共接入、布局与初始化、多主题及技术证据；复用既有编码和部署能力。",
  "entry": "AGENTS.md",
  "rules": "rules/",
  "references": "references/",
  "skills": "skills/",
  "templates": "templates/",
  "scripts": "scripts/",
  "initSkill": "iris-ui-init",
  "thinIndex": {
    "excludeSkills": [
      "iris-ui-init"
    ]
  },
  "dependencies": [
    "coding-iris-plugin",
    "imedical-ui"
  ],
  "dependencyVersions": {
    "coding-iris-plugin": {
      "minVersion": "0.20.7",
      "maxVersionExclusive": "0.24.0"
    },
    "imedical-ui": {
      "minVersion": "0.1.3",
      "maxVersionExclusive": "0.2.0"
    }
  },
  "availableDependencies": [
    {
      "plugin": "agent-framework-evolution",
      "stage": "ui-self-regression",
      "trigger": "UI业务需求已由用户验收且发现合格经验或框架缺口；写入须有对应授权",
      "entries": [
        "skills/agent-framework-feedback/SKILL.md"
      ]
    }
  ],
  "requiresProjectFiles": [
    "AGENTS.md",
    ".agents/config/iris_project_profile.md"
  ],
  "defaultPrompt": [
    "按 UI 标注改造这个 HISUI 页面，保留业务契约",
    "排查首屏、滚动或窗口切换后的布局问题",
    "核对多主题适配并记录技术验证与人工验收缺口"
  ]
}
