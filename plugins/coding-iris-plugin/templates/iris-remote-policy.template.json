{
  "schema": "iris-remote-policy/v1",
  "enabled": false,
  "coordinationRoot": "<absolute-private-coordination-directory>",
  "poolKey": "verified-pool-alias",
  "maxConcurrent": 1,
  "allowSharedPool": false,
  "readBatch": {
    "sessions": 1,
    "intervalMs": 200,
    "qualification": {
      "status": "pending",
      "reference": "<reviewed-read-qualification-file>",
      "sha256": "<reviewed-evidence-sha256>"
    }
  },
  "qualification": {
    "status": "pending",
    "reference": "<local-qualification-evidence-file>",
    "channels": {
      "mcp": {
        "processExitVerified": false,
        "acceptInternalRetries": false
      }
    }
  }
}
