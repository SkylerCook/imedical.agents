{
  "name": "agent-context-kit",
  "version": "0.6.0",
  "displayName": "Agent Context Kit",
  "description": "Reusable project context, local task handoff and cross-session continuation, plus schema 2.0 agent run templates and separate demand and framework-maintenance lifecycles.",
  "entry": "AGENTS.md",
  "skills": "skills/",
  "scripts": "scripts/",
  "templates": "templates/",
  "initSkill": "project-context-maintenance",
  "requiresProjectFiles": [
    "AGENTS.md",
    ".agents/rules/",
    ".agents/memory/"
  ],
  "defaultPrompt": [
    "初始化项目规则和项目记忆",
    "维护项目上下文",
    "优化已有上下文中的重复、过时和宽泛约束",
    "判断这条经验应该写到 rules 还是 memory",
    "把项目约定整理成 agent 可复用上下文",
    "初始化或验证 schema 2.0 AGENT 协作 run",
    "为需求启用交接、生成交接快照或继续已有需求"
  ],
  "legacyRootSkillHashes": {
    "coding-agent-adaptation": [
      "c74b680eb4b4f556226a4a252b3d038f326c57c6b5e853d053c736274ad23489"
    ]
  },
  "projectDirectories": [
    {
      "id": "guides",
      "base": "workspace",
      "path": "docs/guides",
      "role": "knowledge",
      "create": "setup",
      "purpose": "开发、操作和排障指南"
    },
    {
      "id": "modules",
      "base": "workspace",
      "path": "docs/modules",
      "role": "knowledge",
      "create": "setup",
      "purpose": "业务专题、接口和设计说明"
    },
    {
      "id": "delivery",
      "base": "workspace",
      "path": "docs/delivery",
      "role": "delivery",
      "create": "setup",
      "purpose": "正式交付、验收、演示和配套附件"
    },
    {
      "id": "archive",
      "base": "workspace",
      "path": "docs/archive",
      "role": "knowledge",
      "create": "setup",
      "purpose": "已被替代的历史资料"
    },
    {
      "id": "handoff",
      "base": "context",
      "path": "work/handoff",
      "role": "runtime",
      "create": "setup",
      "legacyPaths": [
        "docs/handoff"
      ],
      "purpose": "本工作区交接与恢复状态"
    },
    {
      "id": "runs",
      "base": "context",
      "path": "work/agent-reports",
      "role": "runtime",
      "create": "setup",
      "legacyPaths": [
        "docs/agent-reports"
      ],
      "purpose": "新任务运行与证据；旧run保留其显式目录"
    }
  ]
}
