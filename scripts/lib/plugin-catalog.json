        "imedicalxc-doctor-extend-engineer",
        "imedicalxc-doctor-perf-analysis-engineer",
        "imedicalxc-doctor-print-template-design"
      ]
    },
    {
      "id": "ui",
      "name": "UI",
      "description": "公司 UI 规范及 IRIS/HISUI 适配",
