{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plugin projectDirectories",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "base",
      "path",
      "role",
      "create",
      "purpose"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "base": {
        "enum": [
          "workspace",
          "context",
          "capability"
        ]
      },
      "path": {
        "type": "string",
        "minLength": 1
      },
      "role": {
        "enum": [
          "knowledge",
          "delivery",
          "runtime",
          "recovery",
          "source",
          "temporary",
          "capability"
        ]
      },
      "create": {
        "enum": [
          "setup",
          "task",
          "never"
        ]
      },
      "purpose": {
        "type": "string",
        "minLength": 1,
        "description": "面向人和 Agent 的用途；旧声明仍可只读盘点和解析，说明生成/更新会提示缺失来源并要求补齐"
      },
      "examples": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "minLength": 1 }
      },
      "boundary": {
        "type": "string",
        "minLength": 1
      },
      "lifecycle": {
        "type": "string",
        "minLength": 1
      },
      "legacyPaths": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "additionalProperties": false
  }
}
