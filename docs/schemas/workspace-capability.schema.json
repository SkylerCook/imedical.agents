{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imedical.invalid/schemas/workspace-capability.schema.json",
  "title": "imedical.agents workspace capability manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "workspace",
    "contextRoot",
    "capabilityRoot",
    "sharedDirectories",
    "localDirectories",
    "sourceRoots"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "mode": {
      "const": "workspace-overlay"
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "contextRoot": {
      "type": "string",
      "minLength": 1
    },
    "capabilityRoot": {
      "type": "string",
      "minLength": 1
    },
    "sharedDirectories": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "localDirectories": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sourceRoots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "target", "gitRoot"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "gitRoot": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
